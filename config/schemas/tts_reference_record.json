{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplate.com/schemas/v0.1/tts_reference_record.json",
  "title": "Text-to-speech reference arm record",
  "description": "What tools/validation/tts_corpus.py reference wrote: one clip per corpus sentence, synthesized by kokoro's own pipeline on the CPU in float32 from the provisioned model and voice, identified by digest. The clips themselves are held outside the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "arm", "engine", "model", "language", "sample_rate_hz", "clips"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/Sha256", "description": "The digest of the corpus file the clips were made from." }
      }
    },
    "arm": { "type": "string", "const": "upstream-reference" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kokoro", "misaki", "spacy", "en_core_web_sm", "g2p_pins_sha256", "espeak_ng", "torch", "device", "dtype", "threads"],
      "properties": {
        "kokoro": { "type": "string", "minLength": 1 },
        "misaki": { "type": "string", "minLength": 1 },
        "spacy": { "type": "string", "minLength": 1 },
        "en_core_web_sm": { "type": "string", "minLength": 1 },
        "g2p_pins_sha256": { "$ref": "#/definitions/Sha256", "description": "The digest of the speech runtime lock's phonemizer pins, as the corpus's tokenizer records it." },
        "espeak_ng": { "type": "string", "minLength": 1, "description": "The distribution's libespeak-ng1 version." },
        "torch": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "const": "cpu" },
        "dtype": { "type": "string", "const": "float32" },
        "threads": { "type": "integer", "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "weights_sha256", "voice", "voice_sha256"],
      "properties": {
        "config_sha256": { "$ref": "#/definitions/Sha256" },
        "weights_sha256": { "$ref": "#/definitions/Sha256" },
        "voice": { "type": "string", "minLength": 1 },
        "voice_sha256": { "$ref": "#/definitions/Sha256" }
      }
    },
    "language": { "type": "string", "minLength": 1 },
    "sample_rate_hz": { "type": "integer", "const": 24000 },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text_sha256", "phonemes_sha256", "runner_phonemes", "seed", "samples", "clipped_samples", "wav_sha256", "pcm_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text_sha256": { "$ref": "#/definitions/Sha256" },
          "phonemes_sha256": { "$ref": "#/definitions/Sha256", "description": "The phonemes kokoro's pipeline synthesized." },
          "runner_phonemes": { "type": "boolean", "description": "Whether those equal the phonemes the Kokoro runner synthesizes for the same text." },
          "seed": { "type": "integer", "minimum": 0, "description": "The torch seed set before the clip; the vocoder draws random phase and noise." },
          "samples": { "type": "integer", "minimum": 1 },
          "clipped_samples": { "type": "integer", "minimum": 0 },
          "wav_sha256": { "$ref": "#/definitions/Sha256" },
          "pcm_sha256": { "$ref": "#/definitions/Sha256" }
        }
      }
    }
  },
  "definitions": {
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
