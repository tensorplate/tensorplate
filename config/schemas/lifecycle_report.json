{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplate.dev/schemas/lifecycle_report.json",
  "title": "Lifecycle validation report",
  "description": "One harness run against one support row. Written by tools/validation/lifecycle-stages.sh and consumed by evidence-bundle assembly, which decides completeness from the stage set rather than from prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_id",
    "started_at",
    "finished_at",
    "outcome",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "row_id": {
      "type": "string",
      "description": "The support row this run validates. A report whose row is not in the registry is evidence for nothing.",
      "minLength": 1
    },
    "harness": {
      "type": "string",
      "description": "Which harness produced this run, for reproducing it.",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail"
      ],
      "description": "pass only when every stage passed. A run that aborted mid-way is a fail with the stages it reached."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "log"
        ],
        "properties": {
          "stage": {
            "enum": [
              "install",
              "upgrade",
              "deploy-smoke",
              "status-logs",
              "rollback",
              "restart",
              "crash-loop",
              "offline"
            ],
            "description": "The eight lifecycle stages. A closed set so a report missing one is detectable rather than merely shorter."
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the stage began. Present only for a stage that ran."
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the stage ended. Present only for a stage that ran."
          },
          "log": {
            "type": "string",
            "description": "Log file for this stage, relative to the report. Attached whether the stage passed or failed: a passing stage's log is what a later regression is diffed against.",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "description": "Why a stage failed or was skipped. Required for both, since an unexplained skip is indistinguishable from an omission."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "fail",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "detail"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "started_at",
                "finished_at"
              ]
            }
          }
        ]
      }
    }
  }
}
