{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplate.com/schemas/v0.1/streaming_footprint_record.json",
  "title": "Streaming footprint record",
  "description": "Machine-readable result of one run of tools/validation/streaming-footprint.sh: the declared budgets as read, the two serving packages measured (built with and without the streaming feature), the raw per-run measurements each side produced, and the deltas and verdict derived from them. The checker recomputes every derived field from the raw measurements and refuses a record whose derived fields disagree. A record describes a footprint measurement on one machine; it is never Production lifecycle evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "provenance",
    "tool",
    "recorded_at_utc",
    "host",
    "thresholds",
    "sides",
    "result"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "record_kind": { "type": "string", "const": "streaming_footprint" },
    "provenance": {
      "type": "string",
      "enum": ["recorded", "synthetic"],
      "description": "`recorded` for a run against real packages on the machine the thresholds are defined for; `synthetic` for a record produced by the tool's test environment, whose numbers measure nothing."
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_commit"],
      "properties": {
        "name": { "type": "string", "const": "streaming-footprint" },
        "source_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "recorded_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "kernel"],
      "properties": {
        "machine": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 }
      }
    },
    "thresholds": { "$ref": "#/definitions/Thresholds" },
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_streaming", "without_streaming"],
      "properties": {
        "with_streaming": { "$ref": "#/definitions/Side" },
        "without_streaming": { "$ref": "#/definitions/Side" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "budgets"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "incomplete"],
          "description": "`pass` only when every budget is complete and within its threshold; `fail` when every budget is complete and one exceeds it; `incomplete` otherwise."
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed_size", "idle_rss", "steady_rss"],
          "properties": {
            "installed_size": { "$ref": "#/definitions/BudgetResult" },
            "idle_rss": { "$ref": "#/definitions/BudgetResult" },
            "steady_rss": { "$ref": "#/definitions/BudgetResult" }
          }
        }
      }
    }
  },
  "definitions": {
    "Thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_kind", "link_model", "runs", "budgets"],
      "description": "The declared budgets, copied as read from tools/validation/streaming-footprint-thresholds.json. The checker refuses a record whose copy differs from that file.",
      "properties": {
        "schema_version": { "type": "string", "const": "0.1" },
        "record_kind": { "type": "string", "const": "streaming_footprint_thresholds" },
        "link_model": {
          "type": "string",
          "const": "static",
          "description": "The budgets are defined only for a worker that links the streaming stack statically."
        },
        "runs": { "type": "integer", "minimum": 1 },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed_size", "idle_rss", "steady_rss"],
          "properties": {
            "installed_size": { "$ref": "#/definitions/Budget" },
            "idle_rss": { "$ref": "#/definitions/Budget" },
            "steady_rss": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_delta_bytes", "streams", "what"],
              "properties": {
                "max_delta_bytes": { "type": "integer", "minimum": 0 },
                "streams": { "type": "integer", "minimum": 1 },
                "what": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_delta_bytes", "what"],
      "properties": {
        "max_delta_bytes": { "type": "integer", "minimum": 0 },
        "what": { "type": "string", "minLength": 1 }
      }
    },
    "Side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version_output", "runs"],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "version", "architecture"],
          "properties": {
            "file": { "type": "string", "minLength": 1, "description": "The package's file name, never a path." },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "version": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        },
        "version_output": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The lines `tensorplate-serving --version` printed, as recorded; nothing here interprets them."
        },
        "runs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Run" }
        }
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "elf_files", "idle_rss_samples_kib", "steady"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "elf_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "stripped_bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 0 },
              "stripped_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "idle_rss_samples_kib": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "description": "VmRSS from /proc/<pid>/status, in KiB as the kernel prints it, sampled after /health reported ready."
        },
        "steady": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "streams", "samples_kib"],
          "properties": {
            "status": { "type": "string", "enum": ["measured", "not_run"] },
            "reason": { "type": ["string", "null"] },
            "streams": { "type": ["integer", "null"], "minimum": 1 },
            "samples_kib": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "BudgetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_streaming_bytes", "without_streaming_bytes", "max_delta_bytes", "max_delta_bytes_allowed", "status", "reason"],
      "description": "Per-run values for each side, the maximum delta (the largest with-streaming value minus the smallest without-streaming value) and whether it is within the threshold.",
      "properties": {
        "with_streaming_bytes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "without_streaming_bytes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "max_delta_bytes": { "type": ["integer", "null"] },
        "max_delta_bytes_allowed": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["within", "exceeded", "incomplete"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
