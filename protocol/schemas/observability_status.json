{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplate.com/schemas/v0.1/observability_status.json",
  "title": "TensorPlate Observability Status Snapshot",
  "description": "V01-E10-F06 minimal status snapshot exposed by `tensorplate-observability`. Surfaces the v0.1.0 required fields plus bookkeeping required by the V01-E11 CLI (`tensorplate status`) and the release validation harness. Snapshot writes are atomic so readers never observe partial records; the schema is versioned and rejects unknown versions through the V01-E02 `decode_with_version_check` path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observability_state",
    "agent_state",
    "serving_state",
    "missed_heartbeat_count",
    "missed_deadline_rate",
    "queue_depth"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "observability_state": {
      "type": "string",
      "enum": ["ready", "degraded", "failed", "no_heartbeat"]
    },
    "agent_state": {
      "type": "string",
      "enum": ["ready", "degraded", "failed", "unknown"]
    },
    "serving_state": {
      "type": "string",
      "enum": ["ready", "degraded", "failed", "unknown"]
    },
    "active_deployment": {"type": "string"},
    "backend": {"type": "string"},
    "missed_heartbeat_count": {"type": "integer", "minimum": 0},
    "missed_deadline_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "queue_depth": {"type": "integer", "minimum": 0},
    "last_error_code": {
      "type": "string",
      "enum": [
        "config_invalid",
        "load_failed",
        "not_ready",
        "shape_mismatch",
        "unsupported",
        "oom_error",
        "timeout",
        "inference_failed",
        "internal"
      ]
    },
    "last_event_sequence": {"type": "integer", "minimum": 0},
    "last_heartbeat_age_ms": {"type": "integer", "minimum": 0},
    "safe_state_sink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dropped", "errors"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dropped": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "ros2_publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "published", "errors"],
      "properties": {
        "enabled": {"type": "boolean"},
        "topic": {"type": "string"},
        "published": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "dropped",
        "malformed",
        "duplicates",
        "out_of_order",
        "unknown_version"
      ],
      "properties": {
        "accepted": {"type": "integer", "minimum": 0},
        "dropped": {"type": "integer", "minimum": 0},
        "malformed": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "out_of_order": {"type": "integer", "minimum": 0},
        "unknown_version": {"type": "integer", "minimum": 0}
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "recent_transitions", "recent_errors"],
      "properties": {
        "capacity": {"type": "integer", "minimum": 1},
        "recent_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["previous_state", "state", "reason", "monotonic_age_ms"],
            "properties": {
              "previous_state": {"type": "string"},
              "state": {"type": "string"},
              "reason": {"type": "string"},
              "monotonic_age_ms": {"type": "integer", "minimum": 0}
            }
          }
        },
        "recent_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "code", "message"],
            "properties": {
              "component": {"type": "string"},
              "code": {"type": "string"},
              "message": {"type": "string"}
            }
          }
        }
      }
    },
    "diagnostics_sink": {
      "type": "object",
      "additionalProperties": false,
      "description": "V01-E12-F06 retention sink health surfaced through `tensorplate doctor` and `tensorplate status`.",
      "required": ["enqueued", "dropped_queue_full", "file_write_errors", "file_rotations"],
      "properties": {
        "enqueued": {"type": "integer", "minimum": 0},
        "dropped_queue_full": {"type": "integer", "minimum": 0},
        "dropped_redacted": {"type": "integer", "minimum": 0},
        "file_write_errors": {"type": "integer", "minimum": 0},
        "file_rotations": {"type": "integer", "minimum": 0},
        "drains": {"type": "integer", "minimum": 0}
      }
    },
    "metrics_export": {
      "type": "object",
      "additionalProperties": false,
      "description": "V01-E12-F04 metrics registry health.",
      "required": ["series_registered", "samples_recorded", "sink_write_errors"],
      "properties": {
        "series_registered": {"type": "integer", "minimum": 0},
        "samples_recorded": {"type": "integer", "minimum": 0},
        "series_rejected_unknown_label": {"type": "integer", "minimum": 0},
        "series_rejected_bounded_label": {"type": "integer", "minimum": 0},
        "series_rejected_full": {"type": "integer", "minimum": 0},
        "samples_dropped_queue_full": {"type": "integer", "minimum": 0},
        "sink_write_errors": {"type": "integer", "minimum": 0}
      }
    },
    "control_loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "V01-E12-F05 rolling control-loop summary. Present when the serving worker emits action outputs for a VLA validation endpoint; absent otherwise.",
      "required": ["control_frequency_hz", "samples", "missed_deadline_rate"],
      "properties": {
        "control_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "rolling_window_seconds": {"type": "integer", "minimum": 1, "default": 60},
        "samples": {"type": "integer", "minimum": 0},
        "missed_deadlines": {"type": "integer", "minimum": 0},
        "missed_deadline_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "jitter_p50_ms": {"type": "number", "minimum": 0},
        "jitter_p95_ms": {"type": "number", "minimum": 0},
        "jitter_p99_ms": {"type": "number", "minimum": 0},
        "jitter_max_ms": {"type": "number", "minimum": 0},
        "mean_frequency_hz": {"type": "number", "minimum": 0},
        "frequency_stddev_hz": {"type": "number", "minimum": 0},
        "frequency_error_pct": {"type": "number", "minimum": 0},
        "endpoint": {"type": "string"},
        "model_class": {"type": "string"},
        "model_name": {"type": "string"},
        "backend": {"type": "string"}
      }
    },
    "last_correlation_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "V01-E12-F02 last correlation id observed by the snapshot writer (deploy or inference). Useful for the operator to join `tensorplate logs` output with the current status."
    },
    "last_failure_reason": {
      "type": "string",
      "description": "V01-E12-F03 last operator-visible failure reason recorded by the snapshot writer. Bounded to the failure_reason.json taxonomy."
    }
  }
}
