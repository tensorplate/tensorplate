#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# V01-E14-F02: tensorplate-observability post-install.
#
# The observability service shares the `tensorplate` system user/group
# with the agent. We call the shared installer so the package is
# self-contained even when installed without the agent.

set -e

case "$1" in
    configure)
        /usr/share/tensorplate/packaging/scripts/create-users.sh
        /usr/share/tensorplate/packaging/scripts/install-paths.sh
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "tensorplate-observability.postinst: unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
