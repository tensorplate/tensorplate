#!/usr/bin/make -f
# -*- makefile -*-
# SPDX-License-Identifier: Apache-2.0
#
# V01-E14 packaging rules. The upstream build (Rust workspace + C++
# CMake build) is invoked by external CI / driver scripts and stages
# binaries under debian/<pkg>/ via the per-package *.install files.
# This rules file deliberately keeps the build target empty so the
# packaging tree can be linted and dry-run-built independently of the
# upstream toolchain.

export DH_VERBOSE = 1

# Honour SOURCE_DATE_EPOCH for reproducible-build CI when callers set it.
ifndef SOURCE_DATE_EPOCH
export SOURCE_DATE_EPOCH := $(shell date +%s)
endif

# The speech runtime family builds only under this profile, from a wheelhouse
# fetched beforehand by packaging/speech-runtime/build-environment.py fetch.
speech_runtime_profile := $(filter pkg.tensorplate.speech-runtime,$(DEB_BUILD_PROFILES))
TP_SPEECH_RUNTIME_LOCK_DIR ?= packaging/speech-runtime/lock

%:
	dh $@

# Upstream binaries are built outside debhelper for v0.1.0. The driver
# script that produces them must run before `dpkg-buildpackage`.
override_dh_auto_configure:
	@echo "tensorplate: upstream configure is driven externally; debian/rules configure step is a no-op"

# The tensorplate-apt-source keyring is reviewed in git as ASCII armor
# and shipped dearmored (binary OpenPGP) because the installed Signed-By
# path is /usr/share/keyrings/tensorplate-archive-keyring.gpg.
# `gpg --dearmor` is a deterministic transform of the committed .asc;
# debian/generated/ is removed by dh_clean via debian/clean.
override_dh_auto_build:
	@echo "tensorplate: upstream build is driven externally; debian/rules build step is a no-op"
	mkdir -p debian/generated/.gnupg
	chmod 700 debian/generated/.gnupg
	GNUPGHOME=$(CURDIR)/debian/generated/.gnupg gpg --batch --yes --dearmor \
		--output debian/generated/tensorplate-archive-keyring.gpg \
		packaging/apt/tensorplate-archive-keyring.asc

override_dh_auto_test:
	@echo "tensorplate: tests run in their native harnesses; see test/"

override_dh_auto_install:
	@echo "tensorplate: install is driven by per-package *.install manifests"
ifneq (,$(speech_runtime_profile))
	@if dh_listpackages | grep -qx tensorplate-speech-runtime-base; then \
		test -n "$(TP_SPEECH_RUNTIME_WHEELHOUSE)" || \
			{ echo "tensorplate: set TP_SPEECH_RUNTIME_WHEELHOUSE to a fetched wheelhouse" >&2; exit 1; }; \
		set -x; /usr/bin/python3.12 packaging/speech-runtime/build-environment.py build \
			--lock-dir "$(TP_SPEECH_RUNTIME_LOCK_DIR)" \
			--wheelhouse "$(TP_SPEECH_RUNTIME_WHEELHOUSE)" \
			--work-dir debian/speech-runtime-work \
			--destdir debian --source-root .; \
	fi
endif

# Make sure dh_installsystemd installs but does not start the units.
# Operators run `systemctl enable --now tensorplate-agent` after the
# clean-install doctor pass, per docs/install/.
override_dh_installsystemd:
	dh_installsystemd --no-start -ptensorplate-agent
	dh_installsystemd --no-start -ptensorplate-observability

# JetPack installs CUDA runtime libraries under /usr/local/cuda-* without
# Debian shlibs metadata. The serving worker links those libraries only
# when built with TP_ENABLE_TENSORRT=ON for the Jetson package; doctor and
# the E15 validation runbook own the runtime dependency check.
ifeq (,$(speech_runtime_profile))
override_dh_shlibdeps:
	dh_shlibdeps -ptensorplate-serving --dpkg-shlibdeps-params=--ignore-missing-info
	dh_shlibdeps -a -Ntensorplate-serving
else
# The environment ships its wheels as fetched: nothing strips, rewrites or
# scans their libraries, and the driver library they load is not a package.
override_dh_strip override_dh_dwz override_dh_strip_nondeterminism override_dh_makeshlibs override_dh_shlibdeps:
	@echo "tensorplate: $@ is skipped for the speech runtime family"

override_dh_compress:
	dh_compress -Xthird-party-licenses.json

# Pinned: the packages were sized against the release asset limit at this level.
override_dh_builddeb:
	dh_builddeb -- -Zzstd -z19
endif
