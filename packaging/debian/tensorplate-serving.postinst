#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# V01-E14-F02: tensorplate-serving post-install.
#
# Installs only the binary and a default config. No systemd unit. The
# agent supervises the serving worker (V01-E09). We still call the
# shared layout helpers because `tensorplate-serving` may be installed
# standalone on a development host that does not have the agent yet.

set -e

case "$1" in
    configure)
        /usr/share/tensorplate/packaging/scripts/create-users.sh
        /usr/share/tensorplate/packaging/scripts/install-paths.sh
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "tensorplate-serving.postinst: unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
