#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# V01-E14-F02: tensorplate-cli post-install.
#
# The CLI only needs the config file under /etc/tensorplate. It does
# not require the system user/group, but if installed alongside the
# agent the directory must exist with the correct permissions; we
# call the shared installer for idempotency.

set -e

case "$1" in
    configure)
        /usr/share/tensorplate/packaging/scripts/install-paths.sh || true
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "tensorplate-cli.postinst: unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
