root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.cmake]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.py]
indent_size = 4

[*.{rs,cpp,cxx,cc,h,hpp,hxx}]
indent_size = 4

[Makefile]
indent_style = tab
