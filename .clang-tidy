---
# TensorPlate C++ static analysis baseline.
# Run with: clang-tidy -p build path/to/file.cpp
#
# CI invokes clang-tidy via run-clang-tidy on compile_commands.json. The
# baseline enables a focused set of bugprone, modernize, performance, and
# core guideline checks; nuisance checks are explicitly suppressed.

Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter

WarningsAsErrors: ""
HeaderFilterRegex: '^(include/tensorplate|runtime|serving_worker)/.*'
FormatStyle: file

CheckOptions:
  - { key: readability-braces-around-statements.ShortStatementLines, value: '0' }
  - { key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions, value: 'true' }
  - { key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor, value: 'true' }
  - { key: modernize-use-default-member-init.UseAssignment, value: 'true' }
