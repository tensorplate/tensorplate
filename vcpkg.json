{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tensorplate",
  "version-string": "0.1.0-dev",
  "description": "TensorPlate edge AI inference platform.",
  "homepage": "https://github.com/tensorplate/tensorplate",
  "license": "Apache-2.0",
  "supports": "(linux | osx | windows) & !uwp",
  "builtin-baseline": "99a97de2cb371449d4fb9dc970f2ac562d689ec2",
  "dependencies": [
    {
      "name": "gtest",
      "version>=": "1.14.0"
    }
  ],
  "features": {
    "tensorrt-adapter": {
      "description": "Build the TensorRT backend adapter (system-provided TensorRT, not vendored).",
      "dependencies": []
    },
    "libtorch-adapter": {
      "description": "Build the PyTorch/LibTorch backend adapter.",
      "dependencies": []
    }
  }
}
